  @@index([profileId, sortOrder])
  @@map("clinic_intake_form_fields")
}

model CoworkingProfile {
  id        String   @id @default(uuid()) @db.Uuid
  businessId String  @unique @map("business_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  spaces   CoworkingSpace[]

  @@map("coworking_profiles")
}

model CoworkingSpace {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  resourceId String   @unique @map("resource_id") @db.Uuid
  spaceType  String   @map("space_type") @db.VarChar(50)
  capacity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  profile  CoworkingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resource Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("coworking_spaces")
}

model HotelProfile {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @unique @map("business_id") @db.Uuid
  checkInTime  String   @default("14:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime String   @default("12:00") @map("check_out_time") @db.VarChar(5)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roomTypes HotelRoomType[]

  @@map("hotel_profiles")
}

model HotelRoomType {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  maxGuests    Int      @map("max_guests")
  basePrice    Decimal  @map("base_price") @db.Decimal(12, 0)
  inventoryCount Int    @map("inventory_count")
  minNights    Int      @default(1) @map("min_nights")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  profile   HotelProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rooms     HotelRoom[]
  ratePlans HotelRatePlan[]

  @@index([profileId])
  @@index([deletedAt])
  @@map("hotel_room_types")
}

model HotelRoom {
  id         String   @id @default(uuid()) @db.Uuid
  roomTypeId String   @map("room_type_id") @db.Uuid
  resourceId String   @unique @map("resource_id") @db.Uuid
  roomNumber String   @map("room_number") @db.VarChar(20)
  floor      Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  roomType HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  resource Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, roomNumber])
  @@index([roomTypeId])
  @@index([deletedAt])
  @@map("hotel_rooms")
}

model HotelRatePlan {
  id          String   @id @default(uuid()) @db.Uuid
  roomTypeId  String   @map("room_type_id") @db.Uuid
  name        String   @db.VarChar(100)
  pricePerNight Decimal @map("price_per_night") @db.Decimal(12, 0)
  validFrom   DateTime @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  isRefundable Boolean @default(true) @map("is_refundable")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  roomType HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, validFrom])
  @@index([deletedAt])
  @@map("hotel_rate_plans")
}

// ---------------------------------------------------------------------------
// Catalog — resources & services
// ---------------------------------------------------------------------------

model Resource {
  id         String         @id @default(uuid()) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  locationId String         @map("location_id") @db.Uuid
  name       String         @db.VarChar(100)
  type       ResourceType
  status     ResourceStatus @default(active)
  capacity   Int            @default(1)
  metadata   Json?          @db.JsonB
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  business            Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location            BusinessLocation             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  serviceResources    ServiceResource[]
  blockedSlots        ResourceBlockedSlot[]
  slotHolds           SlotHold[]
  bookingAllocations  BookingResourceAllocation[]
  footballPitch       FootballPitch?
  salonChair          SalonChair?
  restaurantTable     RestaurantTable?
  clinicDoctor        ClinicDoctor?
  coworkingSpace      CoworkingSpace?
  hotelRoom           HotelRoom?

  @@index([businessId])
  @@index([locationId])
  @@index([type, status])
  @@index([deletedAt])
  @@map("resources")
}

model Service {
  id              String       @id @default(uuid()) @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  locationId      String       @map("location_id") @db.Uuid
  name            String       @db.VarChar(150)
  description     String?      @db.Text
  durationMinutes Int          @map("duration_minutes")
  price           Decimal      @db.Decimal(12, 0)
  currency        String       @default("UZS") @db.VarChar(3)
  pricingModel    PricingModel @default(fixed) @map("pricing_model")
  maxPartySize    Int?         @map("max_party_size")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location         BusinessLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  serviceResources ServiceResource[]
  slotHolds        SlotHold[]
  bookingLineItems BookingLineItem[]

  @@index([businessId])
  @@index([locationId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("services")
}

model ServiceResource {
  id         String   @id @default(uuid()) @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, resourceId])
  @@index([resourceId])
  @@map("service_resources")
}

model ResourceBlockedSlot {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz
  endsAt     DateTime @map("ends_at") @db.Timestamptz
  reason     String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, startsAt, endsAt])
  @@map("resource_blocked_slots")
}

// ---------------------------------------------------------------------------
// Booking engine
// ---------------------------------------------------------------------------

model SlotHold {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  locationId String         @map("location_id") @db.Uuid
  serviceId  String         @map("service_id") @db.Uuid
  resourceId String         @map("resource_id") @db.Uuid
  startsAt   DateTime       @map("starts_at") @db.Timestamptz
  endsAt     DateTime       @map("ends_at") @db.Timestamptz
  partySize  Int?           @map("party_size")
  price      Decimal        @db.Decimal(12, 0)
  currency   String         @default("UZS") @db.VarChar(3)
  status     SlotHoldStatus @default(active)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz
  bookingId  String?        @unique @map("booking_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service  Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  resource Resource         @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  booking  Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([resourceId, startsAt, endsAt])
  @@index([expiresAt])
  @@index([status])
  @@map("slot_holds")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  referenceCode   String        @unique @map("reference_code") @db.VarChar(20)
  userId          String?       @map("user_id") @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  locationId      String        @map("location_id") @db.Uuid
  status          BookingStatus @default(pending_payment)
  paymentMethod   PaymentMethod @map("payment_method")
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 0)
  depositAmount   Decimal       @default(0) @map("deposit_amount") @db.Decimal(12, 0)
  currency        String        @default("UZS") @db.VarChar(3)
  partySize       Int?          @map("party_size")
  notes           String?       @db.Text
  policySnapshot  Json          @map("policy_snapshot") @db.JsonB
  startsAt        DateTime      @map("starts_at") @db.Timestamptz
  endsAt          DateTime      @map("ends_at") @db.Timestamptz
  checkedInAt     DateTime?     @map("checked_in_at") @db.Timestamptz
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz
  cancellationReason String?    @map("cancellation_reason") @db.VarChar(200)
  isWalkIn        Boolean       @default(false) @map("is_walk_in")
  walkInName      String?       @map("walk_in_name") @db.VarChar(150)
  walkInPhone     String?       @map("walk_in_phone") @db.VarChar(20)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user         User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  business     Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location     BusinessLocation            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  slotHold     SlotHold?
  lineItems    BookingLineItem[]
  allocations  BookingResourceAllocation[]
  participants BookingParticipant[]
  statusHistory BookingStatusHistory[]
  intakeResponses BookingIntakeResponse[]
  payment      Payment?
  review       Review?
  dispute      Dispute?
  payoutItems  PayoutItem[]
  notifications Notification[]

  @@index([userId, status])
  @@index([businessId, status, startsAt])
  @@index([locationId, startsAt])
  @@index([startsAt, endsAt])
  @@index([status])
  @@index([referenceCode])
  @@map("bookings")
}

model BookingLineItem {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  name            String   @db.VarChar(150)
  durationMinutes Int      @map("duration_minutes")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 0)
  quantity        Int      @default(1)
  subtotal        Decimal  @db.Decimal(12, 0)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([serviceId])
  @@map("booking_line_items")
}

model BookingResourceAllocation {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz
  endsAt     DateTime @map("ends_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at")

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([resourceId, startsAt, endsAt])
  // NOTE: add PostgreSQL exclusion constraint via raw migration SQL:
  // EXCLUDE USING gist (resource_id WITH =, tstzrange(starts_at, ends_at) WITH &&)
  @@map("booking_resource_allocations")
}

model BookingStatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus  BookingStatus @map("to_status")
  actorId   String?       @map("actor_id") @db.Uuid
  actorType String        @default("system") @map("actor_type") @db.VarChar(20)
  note      String?       @db.VarChar(500)
  createdAt DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt(sort: Desc)])
  @@map("booking_status_history")
}

model BookingParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  name      String   @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([userId])
  @@map("booking_participants")
}

model BookingIntakeResponse {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  field   ClinicIntakeFormField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([bookingId, fieldId])
  @@index([bookingId])
  @@map("booking_intake_responses")
}

// ---------------------------------------------------------------------------
// Payments & ledger
// ---------------------------------------------------------------------------

model Payment {
  id            String          @id @default(uuid()) @db.Uuid
  bookingId     String          @unique @map("booking_id") @db.Uuid
  status        PaymentStatus   @default(pending)
  type          PaymentType
  amount        Decimal         @db.Decimal(12, 0)
  currency      String          @default("UZS") @db.VarChar(3)
  provider      PaymentProvider?
  providerRef   String?         @map("provider_ref") @db.VarChar(255)
  paidAt        DateTime?       @map("paid_at") @db.Timestamptz
  failedAt      DateTime?       @map("failed_at") @db.Timestamptz
  failureReason String?         @map("failure_reason") @db.VarChar(500)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  booking      Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([status])
  @@index([provider, providerRef])
  @@map("payments")
}

model PaymentTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  paymentId      String          @map("payment_id") @db.Uuid
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 0)
  currency       String          @default("UZS") @db.VarChar(3)
  provider       PaymentProvider?
  providerTxnId  String?         @map("provider_txn_id") @db.VarChar(255)
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(64)
  rawPayload     Json?           @map("raw_payload") @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt(sort: Desc)])
  @@index([provider, providerTxnId])
  @@map("payment_transactions")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  amount          Decimal      @db.Decimal(12, 0)
  currency        String       @default("UZS") @db.VarChar(3)
  status          RefundStatus @default(pending)
  reason          RefundReason
  providerRefundId String?     @map("provider_refund_id") @db.VarChar(255)
  notes           String?      @db.Text
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model BusinessPayout {
  id                String       @id @default(uuid()) @db.Uuid
  businessId        String       @map("business_id") @db.Uuid
  periodStart       DateTime     @map("period_start") @db.Date
  periodEnd         DateTime     @map("period_end") @db.Date
  grossAmount       Decimal      @map("gross_amount") @db.Decimal(12, 0)
  commissionAmount  Decimal      @map("commission_amount") @db.Decimal(12, 0)
  netAmount         Decimal      @map("net_amount") @db.Decimal(12, 0)
  currency          String       @default("UZS") @db.VarChar(3)
  status            PayoutStatus @default(pending_transfer)
  transferredAt     DateTime?    @map("transferred_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items    PayoutItem[]

  @@unique([businessId, periodStart, periodEnd])
  @@index([businessId, status])
  @@index([periodEnd(sort: Desc)])
  @@map("business_payouts")
}

model PayoutItem {
  id                 String   @id @default(uuid()) @db.Uuid
  payoutId           String   @map("payout_id") @db.Uuid
  bookingId          String   @map("booking_id") @db.Uuid
  grossAmount        Decimal  @map("gross_amount") @db.Decimal(12, 0)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(12, 0)
  netAmount          Decimal  @map("net_amount") @db.Decimal(12, 0)
  createdAt          DateTime @default(now()) @map("created_at")

  payout  BusinessPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([payoutId, bookingId])
  @@index([bookingId])
  @@map("payout_items")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  bookingId  String       @unique @map("booking_id") @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  rating     Int
  comment    String?      @db.Text
  isVerified Boolean      @default(true) @map("is_verified")
  status     ReviewStatus @default(published)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")

  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports  ReviewReport[]

  @@index([businessId, status, createdAt(sort: Desc)])
  @@index([userId])
  @@index([rating])
  @@index([deletedAt])
  @@map("reviews")
}

model ReviewReport {
  id         String             @id @default(uuid()) @db.Uuid
  reviewId   String             @map("review_id") @db.Uuid
  reporterId String             @map("reporter_id") @db.Uuid
  reason     ReviewReportReason
  details    String?            @db.Text
  createdAt  DateTime           @default(now()) @map("created_at")

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@index([reviewId])
  @@map("review_reports")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  bookingId String?          @map("booking_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  title     String           @db.VarChar(200)
  body      String           @db.Text
  metadata  Json?            @db.JsonB
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking    Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([type])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(pending)
  externalId     String?                    @map("external_id") @db.VarChar(255)
  errorMessage   String?                    @map("error_message") @db.VarChar(500)
  attemptCount   Int                        @default(0) @map("attempt_count")
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Admin & platform
// ---------------------------------------------------------------------------

model Dispute {
  id           String            @id @default(uuid()) @db.Uuid
  bookingId    String            @unique @map("booking_id") @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  openedById   String            @map("opened_by_id") @db.Uuid
  assignedToId String?           @map("assigned_to_id") @db.Uuid
  status       DisputeStatus     @default(open)
  resolution   DisputeResolution?
  refundAmount Decimal?          @map("refund_amount") @db.Decimal(12, 0)
  notes        String?           @db.Text
  resolvedAt   DateTime?         @map("resolved_at") @db.Timestamptz
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  openedBy   User     @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  assignedTo User?    @relation("DisputeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([businessId])
  @@index([assignedToId])
  @@map("disputes")
}

model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  actorId    String?         @map("actor_id") @db.Uuid
  action     String          @db.VarChar(100)
  entityType AuditEntityType @map("entity_type")
  entityId   String          @map("entity_id") @db.Uuid
  oldValues  Json?           @map("old_values") @db.JsonB
  newValues  Json?           @map("new_values") @db.JsonB
  ipAddress  String?         @map("ip_address") @db.VarChar(45)
  userAgent  String?         @map("user_agent") @db.VarChar(500)
  createdAt  DateTime        @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model FeaturedListing {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  cityId     String           @map("city_id") @db.Uuid
  category   BusinessCategory
  startsAt   DateTime         @map("starts_at") @db.Timestamptz
  endsAt     DateTime         @map("ends_at") @db.Timestamptz
  sortOrder  Int              @default(0) @map("sort_order")
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  deletedAt  DateTime?        @map("deleted_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  city     City     @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([cityId, category, isActive, startsAt, endsAt])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("featured_listings")
}

model CommissionRate {
  id            String           @id @default(uuid()) @db.Uuid
  category      BusinessCategory
  ratePercent   Int              @map("rate_percent")
  effectiveFrom DateTime         @map("effective_from") @db.Date
  effectiveTo   DateTime?        @map("effective_to") @db.Date
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([category, effectiveFrom(sort: Desc)])
  @@map("commission_rates")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
