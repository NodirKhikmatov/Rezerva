# Copy to .env — see root README.md for setup
# Local: docker compose up -d postgres redis

# Server
PORT=3001
NODE_ENV=development

# Database (required)
# Dev:  npm run prisma:migrate
# Prod: npx prisma migrate deploy
DATABASE_URL=postgresql://ordering:ordering@localhost:5432/ordering

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set true to start Telegraf long-polling (dev) or register webhook handlers (prod)
ENABLE_TELEGRAM_BOT=false

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Sentry
SENTRY_DSN=

# CORS
FRONTEND_URL=http://localhost:3000

# Public API base (used for QR URLs)
API_BASE_URL=http://localhost:3001
